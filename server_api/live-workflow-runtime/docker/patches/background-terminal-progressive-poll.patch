+#[test]
+fn eidosoma_flex_catalog_augmentation_is_allowlisted_and_idempotent() {
+    let mut sol = remote_model("gpt-5.6-sol", "Sol", 1);
+    sol.service_tiers.push(ModelServiceTier {
+        id: "priority".to_string(),
+        name: "Fast".to_string(),
+        description: "Priority processing".to_string(),
+    });
+    let mut terra = remote_model("gpt-5.6-terra", "Terra", 2);
+    terra.service_tiers.push(ModelServiceTier {
+        id: EIDOSOMA_FLEX_SERVICE_TIER_ID.to_string(),
+        name: "Existing Flex".to_string(),
+        description: "Preserve remote metadata".to_string(),
+    });
+    let luna = remote_model("gpt-5.6-luna", "Luna", 3);
+    let namespaced_bedrock = remote_model("openai.gpt-5.6-sol", "Bedrock Sol", 4);
+    let other = remote_model("gpt-5.5", "GPT-5.5", 5);
+    let mut models = vec![sol, terra, luna, namespaced_bedrock, other];
+
+    eidosoma_augment_flex_service_tiers(&mut models);
+    eidosoma_augment_flex_service_tiers(&mut models);
+
+    for slug in EIDOSOMA_FLEX_MODEL_SLUGS {
+        let model = models
+            .iter()
+            .find(|model| model.slug == slug)
+            .expect("allowlisted model should remain in the catalog");
+        assert_eq!(
+            model
+                .service_tiers
+                .iter()
+                .filter(|tier| tier.id == EIDOSOMA_FLEX_SERVICE_TIER_ID)
+                .count(),
+            1,
+            "Flex should be added exactly once to {slug}"
+        );
+        assert_eq!(
+            model.service_tier_for_request(Some(EIDOSOMA_FLEX_SERVICE_TIER_ID.to_string())),
+            Some(EIDOSOMA_FLEX_SERVICE_TIER_ID.to_string())
+        );
+    }
+
+    let terra = models
+        .iter()
+        .find(|model| model.slug == "gpt-5.6-terra")
+        .expect("Terra should remain in the catalog");
+    let terra_flex = terra
+        .service_tiers
+        .iter()
+        .find(|tier| tier.id == EIDOSOMA_FLEX_SERVICE_TIER_ID)
+        .expect("Terra should retain its existing Flex tier");
+    assert_eq!(terra_flex.name, "Existing Flex");
+    assert_eq!(terra_flex.description, "Preserve remote metadata");
+
+    for slug in ["openai.gpt-5.6-sol", "gpt-5.5"] {
+        let model = models
+            .iter()
+            .find(|model| model.slug == slug)
+            .expect("non-allowlisted model should remain in the catalog");
+        assert!(
+            model
+                .service_tiers
+                .iter()
+                .all(|tier| tier.id != EIDOSOMA_FLEX_SERVICE_TIER_ID),
+            "Flex should not be added to {slug}"
+        );
+    }
+}
