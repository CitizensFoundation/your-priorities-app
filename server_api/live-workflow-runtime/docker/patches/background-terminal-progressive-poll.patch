+/// Add the Eidosoma Flex option to the exact first-party OpenAI model allowlist.
+///
+/// Callers must ensure the catalog belongs to the OpenAI provider. This helper
+/// intentionally does not run inside [`StaticModelsManager`], whose catalogs
+/// can be authoritative for providers that do not support Flex.
+pub fn eidosoma_augment_flex_service_tiers(models: &mut [ModelInfo]) {
+    for model in models {
+        if EIDOSOMA_FLEX_MODEL_SLUGS.contains(&model.slug.as_str())
+            && !model
+                .service_tiers
+                .iter()
+                .any(|tier| tier.id == EIDOSOMA_FLEX_SERVICE_TIER_ID)
+        {
+            model.service_tiers.push(ModelServiceTier {
+                id: EIDOSOMA_FLEX_SERVICE_TIER_ID.to_string(),
+                name: "Flex".to_string(),
+                description: "Flexible processing".to_string(),
+            });
+        }
+    }
+}

