+    let max_background_yield_time_ms =
+        max_background_yield_time_ms.max(MIN_EMPTY_YIELD_TIME_MS);
+    let requested_yield_time_ms = requested_yield_time_ms.max(MIN_YIELD_TIME_MS);
+
+    if !input_is_empty {
+        return requested_yield_time_ms.min(MAX_YIELD_TIME_MS);
+    }
+
+    let scheduled_yield_time_ms = match completed_background_polls {
+        0 => FIRST_BACKGROUND_POLL_YIELD_TIME_MS,
+        1 => SECOND_BACKGROUND_POLL_YIELD_TIME_MS,
+        _ => max_background_yield_time_ms,
+    };
+    scheduled_yield_time_ms
+        .min(max_background_yield_time_ms)
+        .max(MIN_EMPTY_YIELD_TIME_MS)
+}
