# Copy to /etc/yp-live-workflow/vm.env with mode 0600; replace host/token/origin.
# Use the existing site origin. No separate ChatGPT domain registration.
YP_LIVE_WORKFLOW_API_BASE_URL=https://yrpri.org
YP_LIVE_WORKFLOW_VM_HOST_ID=55555555-5555-4555-8555-555555555555
YP_LIVE_WORKFLOW_VM_AGENT_TOKEN=REPLACE_WITH_THE_MATCHING_API_HOST_TOKEN
YP_LIVE_WORKFLOW_VM_WORKSPACE_ROOT=/srv/yp-workflows
YP_LIVE_WORKFLOW_VM_AGENT_STATE_PATH=/srv/yp-workflow-state/vm-agent-state.json
YP_LIVE_WORKFLOW_VM_ARCHIVE_ROOT=/srv/yp-workflow-archive
YP_LIVE_WORKFLOW_VM_DATASETS_HOT_ROOT=/srv/yp-workflow-datasets
YP_LIVE_WORKFLOW_CODEX_ALLOWED_IMAGES=yp-live-workflow/codex-runtime:1
YP_LIVE_WORKFLOW_CODEX_CONTAINER_IMAGE=yp-live-workflow/codex-runtime:1
YP_LIVE_WORKFLOW_PROCESSING_IMAGE=yp-live-workflow/processing-runtime:1
YP_LIVE_WORKFLOW_DOCKER_RUNTIME=sysbox-runc
YP_LIVE_WORKFLOW_DOCKER_RUN_USER=0:0
YP_LIVE_WORKFLOW_MIN_FREE_BYTES=1073741824
