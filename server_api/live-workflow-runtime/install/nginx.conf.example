# Merge into the installation's existing HTTPS virtual host (yrpri.org or
# ypus.org). Keep its existing certificates, authentication and other routes.
# Place map/upstream in the nginx http context. One API process owns the broker.
map $http_upgrade $yp_workflow_upgrade {
    default upgrade;
    '' close;
}
upstream yp_workflow_api {
    server 127.0.0.1:4242;
}

# Place this location in each existing server block. Set PUBLIC_ORIGIN to that
# installation's UI origin and forward all workflow requests to this upstream.
location /api/live-workflows/ {
    proxy_pass http://yp_workflow_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $yp_workflow_upgrade;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 900s;
    client_body_timeout 900s;
    client_max_body_size 250m;
}
