{
  "nodes": [
    {
      "id": "normalize",
      "kind": "agent",
      "label": "Normalize records",
      "description": "Requires imported table or document records. Produces standard jobs with stable input IDs, original text and provenance. For unfamiliar formats, add an adapter before this node; preserve IDs and every source qualification.",
      "entrypoint": "source/normalize.ts",
      "enabled": true,
      "models": {},
      "configuration": {
        "jurisdiction": "New Jersey, USA"
      },
      "position": {
        "x": 40,
        "y": 140
      }
    },
    {
      "id": "levels",
      "kind": "agent",
      "label": "Split and verify job levels",
      "description": "Requires normalize. Splits multi-level descriptions and independently checks shared duties and level-specific qualifications before any analysis. Children keep parent lineage; qualifications must not transfer between levels.",
      "entrypoint": "source/levels.ts",
      "enabled": true,
      "models": {},
      "configuration": {
        "maxLevels": 8
      },
      "position": {
        "x": 300,
        "y": 140
      }
    },
    {
      "id": "analyze",
      "kind": "agent",
      "label": "Analyze requirements",
      "description": "Requires normalize and levels. Internal tasks run in order: degrees, evidence, mandatory, licenses, barriers, consistency, readingLevel. evidence requires degrees; consistency requires degrees, evidence, mandatory, licenses and barriers. Other tasks read the original job independently. configuration.tasks selects tasks and automatically includes their prerequisites; omit it for all seven. For a small early experiment use tasks: [evidence] and trial --target analyze: only degrees and evidence run, after normalize and levels.",
      "entrypoint": "source/analysis.ts",
      "enabled": true,
      "models": {},
      "configuration": {},
      "position": {
        "x": 560,
        "y": 140
      }
    },
    {
      "id": "licenses",
      "kind": "agent",
      "label": "License and degree research",
      "description": "Optional. Requires analyzed job requirements and an approved Firecrawl binding. Independently verifies applicable license and education evidence; unresolved claims remain unknown.",
      "entrypoint": "source/research.ts",
      "enabled": false,
      "models": {},
      "configuration": {
        "topic": "professional license and degree requirements",
        "firecrawlBinding": "firecrawl",
        "maxPages": 3,
        "queriesPerRound": 2,
        "maxSources": 4,
        "maxFollowupRounds": 1,
        "maxDocuments": 2,
        "maxDocumentPages": 10,
        "maxDocumentChars": 60000
      },
      "position": {
        "x": 820,
        "y": 140
      }
    },
    {
      "id": "education",
      "kind": "agent",
      "label": "Education and statute research",
      "description": "Optional. Follows analysis and any enabled license research. Requires an approved Firecrawl binding for statutory education evidence.",
      "entrypoint": "source/research.ts",
      "enabled": false,
      "models": {},
      "configuration": {
        "topic": "statutory education requirements and barriers",
        "firecrawlBinding": "firecrawl",
        "maxPages": 3,
        "queriesPerRound": 2,
        "maxSources": 4,
        "maxFollowupRounds": 1,
        "maxDocuments": 2,
        "maxDocumentPages": 10,
        "maxDocumentChars": 60000
      },
      "position": {
        "x": 1080,
        "y": 140
      }
    },
    {
      "id": "rewrite",
      "kind": "agent",
      "label": "Rewrite and validate",
