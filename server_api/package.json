  "scripts": {
    "copyInLocalAgents": "cp -R ../../policy-synth/agents/ts-out/* ./node_modules/@policysynth/agents/;cp ../../policy-synth/agents/src/*.d.ts ./node_modules/@policysynth/agents/;",
    "publish_live_with_copy": "npm run build:dev;copyfiles './src/utils/**/*.d.ts' './src/controllers/**/*.d.ts' './src/agents/**/*.d.ts' './src/models/**/*.d.ts' './src/services/controllers/**/*.d.ts' './src/services/models/**/*.d.ts' 'ts-out/';npm pack && node repack && node publish.js https://registry.npmjs.org/",
    "publish_live": "npm run build:dev;npm pack && node repack && node publish.js https://registry.npmjs.org/",
    "publish_local": "npm run build;npm pack && node repack && node publish.js http://localhost:4873",
    "test": "node --test ./src/tests/*.test.cjs && npm run test:live-workflows",
    "start": "nodemon -e ts ts-out/server.js",
    "watch-start": "DEBUG=router:* tsc --outDir ./ts-out -w & nodemon -q ./ts-out/server.js",
    "dev": "nodemon --config nodemon.json ./ts-out/server.js",
    "heroku-postbuild": "echo 'Skipping build'",
    "dev:debug": "nodemon --config nodemon.json --inspect-brk api_app.ts",
    "build": "tsc --outDir ./dist && ncp src/views dist/views && ncp config dist/config && ncp src/services/email_templates dist/services/email_templates && ncp src/services/locales dist/services/locales",
    "build:dev": "tsc  --outDir ./ts-out && ncp src/views ts-out/views && ncp config ts-out/config && ncp src/services/email_templates ts-out/services/email_templates && ncp src/services/locales ts-out/services/locales",
    "build:live-workflows": "tsc -p tsconfig.live-workflows.json",
    "typecheck:live-workflows": "tsc --noEmit -p workflow-packages/skills-first/tsconfig.json",
    "test:live-workflows": "node --import tsx --test --test-isolation=none src/liveWorkflows/tests/*.test.ts",
    "test:live-workflows:ported": "node --import tsx --test --test-isolation=none src/liveWorkflows/vm/tests/unit/appServerEvents.unit.test.ts src/liveWorkflows/vm/tests/unit/codexAppServerDefaults.unit.test.ts src/liveWorkflows/vm/tests/unit/codexAuthMaterial.unit.test.ts src/liveWorkflows/vm/tests/unit/codexAuth.unit.test.ts src/liveWorkflows/vm/tests/unit/vmCommandRouter.unit.test.ts src/liveWorkflows/vm/tests/unit/workspaceFileReadCommandHandler.unit.test.ts src/liveWorkflows/vm/tests/unit/artifactCollector.unit.test.ts src/liveWorkflows/contracts/tests/contracts/pathSafety.unit.test.ts src/liveWorkflows/contracts/tests/contracts/protocolSchemas.unit.test.ts",
    "migrate:live-workflows": "node --import tsx src/liveWorkflows/migrateCli.ts",
    "vm:live-workflows": "node live-workflow-runtime/build/vm/cli.js",
    "test:live-workflows:container": "node --import tsx src/liveWorkflows/tests/container.smoke.ts",
    "test:live-workflows:postgres": "node --import tsx src/liveWorkflows/tests/postgres.smoke.ts",
    "preview:live-workflows": "node --import tsx src/liveWorkflows/tests/ui.preview.ts",
    "prepack": "npm run build:live-workflows",
    "evaluate:skills-first": "node --import tsx src/liveWorkflows/tests/evaluateSkillsFirst.ts",
    "check:live-workflows": "node live-workflow-runtime/build/vm/readiness.js",
    "test:live-workflows:browser": "playwright test -c src/liveWorkflows/tests/browser.config.ts",
    "test:live-workflows:codex-image": "node --import tsx src/liveWorkflows/tests/codexImage.smoke.ts",
    "test:live-workflows:manual": "npm run build:live-workflows && node --import tsx src/liveWorkflows/tests/skillsFirst.manual.ts",
    "test:live-workflows:headless": "npm run build:live-workflows && node --import tsx src/liveWorkflows/tests/skillsFirst.headless.manual.ts",
    "test:live-workflows:browser-manual": "npm run build:live-workflows && node --import tsx src/liveWorkflows/tests/skillsFirst.browser.manual.ts",
    "test:live-workflows:browser-idaho": "npm run build:live-workflows && node --import tsx src/liveWorkflows/tests/skillsFirst.idaho.browser.manual.ts",
    "test:live-workflows:browser-create-group": "npm run build:live-workflows && node --import tsx src/liveWorkflows/tests/groupCreation.browser.manual.ts",
    "test:live-workflows:regression": "npm run build:live-workflows && node --import tsx --test --test-concurrency=1 src/liveWorkflows/tests/workflowRegression.browser.ts src/liveWorkflows/tests/documentsRegression.browser.ts"
  },
  "cacheDirectories": [
    "node_modules"
  ]
