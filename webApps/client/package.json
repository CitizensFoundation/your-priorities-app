{
  "name": "@yrpri/webapp",
  "version": "9.0.138",
  "repository": {
    "type": "git",
    "url": "https://github.com/CitizensFoundation/your-priorities-app.git"
  },
  "description": "Your Priorities Web App SDK",
  "author": "Robert Bjarnason, Citizens Foundation",
  "license": "MIT",
  "files": [
    "ts-out/**/*",
    "src/types.d.ts",
    "src/typesAoi.d.ts",
    "src/typesLlms.d.ts",
    "locales/**/*",
    "vendor/deepmerge/**/*"
  ],
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^3.4.2",
    "@forgerock/javascript-sdk": "^4.8.0",
    "@heygen/streaming-avatar": "^2.0.7",
    "@joint/core": "^4.0.4",
    "@kano/twemoji": "^1.0.0",
    "@lit-labs/motion": "^1.0.7",
    "@lit-labs/virtualizer": "^2.0.13",
    "@material/material-color-utilities": "^0.3.0",
    "@material/web": "^2.3.0",
    "@policysynth/agents": "^1.3.204",
    "@polymer/polymer": "^3.5.1",
    "@trystan2k/fleshy-jsoneditor": "^3.0.0",
    "@ungap/structured-clone": "^1.2.0",
    "@vaadin/vaadin-grid": "^23.5.2",
    "backbone": "~1.6.0",
    "blocking-elements": "^0.1.1",
    "broadcastchannel-polyfill": "^1.0.1",
    "chart.js": "^4.4.3",
    "country-flag-emoji-polyfill": "^0.1.8",
    "d3": "^7.9.0",
    "dagre": "^0.8.5",
    "dompurify": "^3.4.17",
    "element-internals-polyfill": "^1.3.11",
    "emoji-picker-element": "^1.21.3",
    "graphlib": "~2.1.8",
    "i18next": "^23.11.5",
    "i18next-http-backend": "^4.0.10",
    "insert-text-at-cursor": "^0.3.0",
    "iso-639-1": "^3.1.2",
    "jquery": "^3.7.1",
    "jsonrepair": "^3.8.0",
    "linkify-html": "^4.1.3",
    "lit": "^3.1.4",
    "lit-flatpickr": "^0.4.0",
    "lit-flexbox-literals": "^0.0.7",
    "lit-google-map": "^1.0.1",
    "luxon": "^3.4.4",
    "marked": "^4.2.12",
    "openai": "^7.53.0",
    "recordrtc": "^5.6.2",
    "share-menu": "^5.1.0",
    "topojson-client": "^3.1.0",
    "urlpattern-polyfill": "^10.0.0",
    "vanilla-colorful": "^0.7.2",
    "wavesurfer.js": "^6.6.4",
    "wicg-inert": "^3.1.2"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "deepmerge": "$deepmerge",
    "glob@>=9 <14.0.2": "^14.0.4",
    "minimatch@>=7 <11.0.1": "^11.0.5",
    "uuid@<11.1.1": "^11.1.1"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.10.2",
    "@open-wc/testing": "^4.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.7",
    "@rollup/plugin-terser": "^1.0.2",
    "@types/chart.js": "^2.9.41",
    "@types/d3": "^7.4.3",
    "@types/glob": "^7.2.0",
    "@types/google.analytics": "^0.0.46",
    "@types/luxon": "^3.4.2",
    "@types/marked": "^4.0.8",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.9",
    "@types/recordrtc": "^5.6.14",
    "@types/topojson": "^3.2.6",
    "@types/topojson-client": "^3.1.4",
    "@types/wavesurfer.js": "^6.0.12",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@web/dev-server": "^1.0.0",
    "@web/dev-server-legacy": "^3.0.0",
    "@web/rollup-plugin-html": "^2.3.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-commands": "^1.0.1",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "concurrently": "^8.2.2",
    "deepmerge": "file:./vendor/deepmerge",
    "eslint": "^8.57.0",
    "fetch-mock": "^10.0.7",
    "glob": "^7.2.0",
    "koa-proxies": "^0.12.4",
    "lit-analyzer": "^2.0.3",
    "mocha": "^12.0.3",
    "rimraf": "^6.1.4",
    "rollup": "^4.18.0",
    "rollup-plugin-copy": "^3.5.0",
    "typescript": "^5.5.3"
  },
  "scripts": {
    "copyInLocalAgents": "cp -R ../../../policy-synth/agents/ts-out/* ./node_modules/@policysynth/agents/;cp ../../../policy-synth/agents/src/*.d.ts ./node_modules/@policysynth/agents/;",
    "build:deepmerge": "tsc -p vendor/deepmerge/tsconfig.json",
    "build:package": "npm run build:deepmerge && tsc",
    "prepack": "npm run build:package && npm run test:esm && npm run test:aoi && npm run test:navigation && npm run test:security && npm run test:release",
    "publish_live": "npm pack && node repack && node publish.js https://registry.npmjs.org/",
    "publish_local": "npm pack && node repack && node publish.js http://localhost:4873",
    "build": "rimraf dist && tsc && rollup -c rollup.config.js && npm run analyze -- --exclude dist && rimraf ../../server_api/webAppsDist/client/dist && cp -r dist/ ../../server_api/webAppsDist/client/",
    "start:build": "web-dev-server --root-dir dist --app-index index.html --open",
    "start": "tsc && concurrently -k -r \"tsc --watch --preserveWatchOutput\" \"wds\"",
    "build:watch": "tsc --watch",
    "clean": "rimraf my-element.{d.ts,d.ts.map,js,js.map} test/my-element.{d.ts,d.ts.map,js,js.map} test/my-element_test.{d.ts,d.ts.map,js,js.map}",
    "lint": "npm run lint:lit-analyzer && npm run lint:eslint",
    "lint:eslint": "eslint 'src/**/*.ts'",
    "lint:lit-analyzer": "lit-analyzer",
    "format": "prettier \"**/*.{cjs,html,js,json,md,ts}\" --ignore-path ./.eslintignore --write",
    "analyze": "cem analyze --litelement --globs \"src/**/*.ts\"",
    "analyze:watch": "cem analyze --litelement --globs \"src/**/*.ts\" --watch",
    "serve": "wds --watch",
    "serve:prod": "MODE=prod npm run serve",
    "test": "npm run test:esm && npm run test:aoi && npm run test:navigation && npm run test:security && npm run test:release && npm run test:dev && npm run test:prod",
    "test:deepmerge": "node --experimental-strip-types --test --test-isolation=none test/deepmerge-security.test.ts",
    "test:security": "npm run test:deepmerge && node --experimental-strip-types --test --test-isolation=none test/translation-security.test.ts test/dependency-security.test.ts",
    "test:release": "node --experimental-strip-types --test --test-isolation=none test/release-lifecycle.test.ts",
    "test:navigation": "node --experimental-strip-types --test --test-isolation=none test/top-app-bar-navigation.test.ts",
    "test:aoi": "node --experimental-strip-types --test --test-isolation=none test/aoi-streaming-analysis.test.ts",
    "test:esm": "node --experimental-strip-types --test --test-isolation=none test/live-workflow-esm.test.ts",
    "test:browser": "tsc -p test/browser/tsconfig.json && wtr --config test/browser/config.ts",
    "test:dev": "npm run test:browser",
    "test:watch": "npm run test:browser -- --watch",
    "test:prod": "MODE=prod npm run test:browser",
    "test:prod:watch": "MODE=prod npm run test:browser -- --watch",
    "checksize": "rollup -c ; cat my-element.bundled.js | gzip -9 | wc -c ; rm my-element.bundled.js"
  }
}
